{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beamcompass.invalid/contracts/snapshot-v2.schema.json",
  "title": "BeamCompass P02 source-only snapshot v2 implementation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "project_id",
    "snapshot_id",
    "manifest",
    "entities",
    "relations",
    "evidence",
    "issues",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "beamcompass.snapshot"
    },
    "schema_version": {
      "const": 2
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "source_digest",
        "config_digest",
        "toolchain",
        "providers"
      ],
      "properties": {
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "elixir",
            "otp"
          ],
          "properties": {
            "elixir": {
              "type": "string",
              "minLength": 1
            },
            "otp": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "version",
              "mode",
              "trust_context"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "const": "source"
              },
              "trust_context": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "semantic_key",
          "epistemic_status",
          "evidence_ids",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "module",
              "function",
              "actor",
              "trigger",
              "state_holder",
              "transition",
              "effect_intent",
              "effect",
              "channel",
              "decision",
              "failure_boundary",
              "behavior"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "semantic_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "epistemic_status": {
            "enum": [
              "sourced",
              "derived",
              "proposed",
              "unresolved"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source_id",
          "target_id",
          "resolution",
          "epistemic_status",
          "evidence_ids",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "implements",
              "handles",
              "owns_state",
              "calls",
              "sends",
              "may_deliver_to",
              "updates_state",
              "describes_effect",
              "performs_effect",
              "supervises",
              "may_restart",
              "occurs_before",
              "potentially_concurrent",
              "causally_related"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved",
              "possible",
              "unresolved"
            ]
          },
          "epistemic_status": {
            "enum": [
              "sourced",
              "derived",
              "proposed",
              "unresolved"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider_id",
          "mode",
          "anchor",
          "basis",
          "input_evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "const": "source"
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "source_sha256",
              "start_line",
              "start_column",
              "end_line",
              "end_column"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "start_column": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "end_column": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "input_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "evidence_ids"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
